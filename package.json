{
  "name": "bgpads-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --filter @bgpads/desktop dev",
    "typecheck": "pnpm --filter @bgpads/shared build && pnpm --filter @bgpads/desktop typecheck",
    "lint": "pnpm --filter @bgpads/desktop lint",
    "format": "pnpm --filter @bgpads/desktop format",
    "build:shared": "pnpm --filter @bgpads/shared build",
    "build:remote": "pnpm --filter @bgpads/remote build",
    "build:desktop": "pnpm --filter @bgpads/desktop build",
    "build": "pnpm build:shared && pnpm build:remote && pnpm build:desktop",
    "build:win": "pnpm build && pnpm --filter @bgpads/desktop exec electron-builder --win",
    "build:mac": "pnpm build && pnpm --filter @bgpads/desktop exec electron-builder --mac",
    "build:linux": "pnpm build && pnpm --filter @bgpads/desktop exec electron-builder --linux",
    "build:unpack": "pnpm build && pnpm --filter @bgpads/desktop exec electron-builder --dir"
  }
}

